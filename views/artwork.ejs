<%- include('partials/header') %>
<p><a href="/">&larr; Back to gallery</a></p>
<div class="detail">
  <div class="detail-image"><img src="/uploads/<%= art.image %>" alt="<%= art.title %>"></div>
  <div class="detail-info">
    <h1><%= art.title %></h1>
    <p class="price big"><%= formatPrice(art.price_minor) %></p>
    <% if (art.medium || art.dimensions) { %>
      <dl class="meta">
        <% if (art.medium) { %><dt>Medium</dt><dd><%= art.medium %></dd><% } %>
        <% if (art.dimensions) { %><dt>Size</dt><dd><%= art.dimensions %></dd><% } %>
      </dl>
    <% } %>
    <% if (art.description) { %><div class="description"><%= art.description %></div><% } %>

    <% if (art.stock <= 0) { %>
      <p class="sold-note">This piece has been sold.</p>
    <% } else { %>
      <form method="post" action="/cart/add" class="buy">
        <input type="hidden" name="_csrf" value="<%= csrf() %>">
        <input type="hidden" name="artworkId" value="<%= art.id %>">
        <% if (art.stock > 1) { %>
          <label>Quantity <input type="number" name="quantity" value="1" min="1" max="<%= art.stock %>"></label>
          <small><%= art.stock %> available</small>
        <% } else { %>
          <small>One of a kind</small>
        <% } %>
        <button class="btn"><%= inCart ? 'Add another to cart' : 'Add to cart' %></button>
      </form>
      <% if (inCart) { %><p><a href="/cart">Already in your cart &rarr;</a></p><% } %>
    <% } %>
  </div>
</div>
<%- include('partials/footer') %>
