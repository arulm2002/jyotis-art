# Copy this file to .env and fill in the values.

# Your website's name and the artist's name (shown on the site)
SITE_NAME=Jyoti's Art
ARTIST_NAME=Jyoti

# The owner/admin login. The account is created on first start.
# (Changing the password here later does NOT change an existing account's password.)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-password

# A long random string used to secure logins. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The public address of the site (no trailing slash). Used for payment redirects.
BASE_URL=http://localhost:3000
PORT=3000

# Currency for prices (3-letter code): usd, inr, jpy, gbp, eur, cad, aud, ...
CURRENCY=usd

# Countries you ship to (2-letter codes, comma separated)
SHIPPING_COUNTRIES=US,CA,GB,IN,JP,AU,SG,DE,FR

# Stripe keys from https://dashboard.stripe.com/apikeys
# Use sk_test_... keys while testing, sk_live_... when you are ready to sell.
STRIPE_SECRET_KEY=
# From Stripe > Developers > Webhooks, for the endpoint <BASE_URL>/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# Try out the full checkout without Stripe (no money is charged). Never enable on the live site.
DEMO_PAYMENTS=false

# Where the database and uploaded pictures are stored. On a hosting service,
# point this at a persistent disk so nothing is lost when the site restarts.
DATA_DIR=./data

# Set to "production" on the live site (enables secure cookies)
NODE_ENV=development
